{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap. Rows are food industries, columns are years. Colour shows the percentage change in workers since 2006: teal for more workers, dark grey for fewer, pale cream for no change.",
  "data": {
    "url": "data/clean/food_jobs_by_industry.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['Change since 2006 (per cent)'])",
      "as": "Change"
    },
    {
      "calculate": "toNumber(datum['Workers (thousands)'])",
      "as": "Workers"
    }
  ],
  "width": "container",
  "height": 260,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelExpr": "datum.value % 5 == 0 ? datum.value : ''",
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "Industry",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "Workers",
            "op": "mean",
            "order": "descending"
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelLimit": 200
          }
        },
        "color": {
          "field": "Change",
          "type": "quantitative",
          "title": "Change since 2006 (per cent)",
          "scale": {
            "domainMid": 0,
            "range": [
              "#484848",
              "#9A958E",
              "#F2EFE9",
              "#8FC4BD",
              "#1F7A74"
            ],
            "clamp": true,
            "interpolate": "lab"
          },
          "legend": {
            "orient": "top",
            "gradientLength": 240,
            "direction": "horizontal",
            "titleOrient": "left"
          }
        },
        "tooltip": [
          {
            "field": "Industry",
            "type": "nominal",
            "title": "Food industry"
          },
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Workers",
            "type": "quantitative",
            "title": "Workers (thousands)",
            "format": ".1f"
          },
          {
            "field": "Change",
            "type": "quantitative",
            "title": "Change since 2006 (per cent)",
            "format": "+.0f"
          }
        ]
      }
    }
  ],
  "encoding": {},
  "padding": {
    "left": 24,
    "top": 5,
    "right": 5,
    "bottom": 5
  }
}