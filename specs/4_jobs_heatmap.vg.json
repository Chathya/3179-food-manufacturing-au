{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap. Rows are food industries, columns are years. Colour shows the percentage change in workers since 2006: blue for more workers, orange for fewer, grey for no change.",
  "data": {
    "url": "data/clean/food_jobs_by_industry.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['Change since 2006 (per cent)'])",
      "as": "Change"
    },
    {
      "calculate": "toNumber(datum['Workers (thousands)'])",
      "as": "Workers"
    }
  ],
  "width": "container",
  "height": 260,
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 1.5,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelExpr": "datum.value % 5 == 0 ? datum.value : ''",
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "Industry",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "Workers",
        "op": "mean",
        "order": "descending"
      },
      "axis": {
        "ticks": false,
        "domain": false,
        "labelLimit": 200
      }
    },
    "color": {
      "field": "Change",
      "type": "quantitative",
      "title": "Change since 2006 (per cent)",
      "scale": {
        "domainMid": 0,
        "range": [
          "#b8481b",
          "#f3a37f",
          "#f0eee9",
          "#86b6ef",
          "#1c5cab"
        ],
        "clamp": true,
        "interpolate": "lab"
      },
      "legend": {
        "orient": "top",
        "gradientLength": 220,
        "direction": "horizontal",
        "titleOrient": "left"
      }
    },
    "tooltip": [
      {
        "field": "Industry",
        "type": "nominal",
        "title": "Food industry"
      },
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Workers",
        "type": "quantitative",
        "title": "Workers (thousands)",
        "format": ".1f"
      },
      {
        "field": "Change",
        "type": "quantitative",
        "title": "Change since 2006 (per cent)",
        "format": "+.0f"
      }
    ]
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}