{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Overview plus detail line chart. Value added by food manufacturing and by all other manufacturing, indexed to 2006-07 = 100. Brushing the small overview chart zooms the detail chart (Shneiderman: overview, zoom; focus plus context).",
  "data": {
    "url": "data/clean/manufacturing_trend.csv"
  },
  "transform": [
    {
      "filter": "datum['Measure'] == 'Industry value added (million dollars)'"
    },
    {
      "calculate": "toNumber(datum['Value'])",
      "as": "Value"
    },
    {
      "calculate": "toNumber(datum['Year ending June'])",
      "as": "Year ending June"
    },
    {
      "window": [
        {
          "op": "first_value",
          "field": "Value",
          "as": "First value"
        }
      ],
      "groupby": [
        "Industry"
      ],
      "sort": [
        {
          "field": "Year ending June",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "calculate": "round(datum['Value'] / datum['First value'] * 1000) / 10",
      "as": "Index"
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 280,
      "layer": [
        {
          "mark": {
            "type": "line",
            "strokeWidth": 2.5,
            "interpolate": "monotone",
            "clip": true
          },
          "encoding": {
            "x": {
              "field": "Year ending June",
              "type": "quantitative",
              "scale": {
                "domain": {
                  "param": "brush"
                },
                "nice": false
              },
              "axis": {
                "title": null,
                "format": "d",
                "tickMinStep": 1,
                "grid": false
              }
            },
            "y": {
              "field": "Index",
              "type": "quantitative",
              "title": "Index, 2006–07 equals 100",
              "scale": {
                "zero": false
              },
              "axis": {
                "tickCount": 5
              }
            },
            "color": {
              "field": "Industry",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Food product manufacturing",
                  "All other manufacturing"
                ],
                "range": [
                  "#eb6834",
                  "#8a837a"
                ]
              },
              "legend": {
                "orient": "top",
                "title": null,
                "direction": "horizontal",
                "symbolType": "stroke",
                "symbolStrokeWidth": 3,
                "columnPadding": 24,
                "labelFontSize": 13,
                "labelLimit": 300,
                "labelExpr": "datum.label == 'Food product manufacturing' ? 'Food factories' : 'All other factories'"
              }
            }
          }
        },
        {
          "params": [
            {
              "name": "hover",
              "select": {
                "type": "point",
                "encodings": [
                  "x"
                ],
                "nearest": true,
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 70,
            "clip": true
          },
          "encoding": {
            "x": {
              "field": "Year ending June",
              "type": "quantitative",
              "scale": {
                "domain": {
                  "param": "brush"
                }
              }
            },
            "y": {
              "field": "Index",
              "type": "quantitative"
            },
            "color": {
              "field": "Industry",
              "type": "nominal",
              "legend": null
            },
            "opacity": {
              "condition": {
                "param": "hover",
                "empty": false,
                "value": 1
              },
              "value": 0
            },
            "tooltip": [
              {
                "field": "Year",
                "type": "nominal",
                "title": "Financial year"
              },
              {
                "field": "Industry",
                "type": "nominal",
                "title": "Industry"
              },
              {
                "field": "Index",
                "type": "quantitative",
                "title": "Index (2006–07 equals 100)",
                "format": ".1f"
              },
              {
                "field": "Value",
                "type": "quantitative",
                "title": "Value added (million dollars)",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": {
                "param": "hover",
                "empty": false
              }
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#cfc8bc",
            "strokeWidth": 1
          },
          "encoding": {
            "x": {
              "field": "Year ending June",
              "type": "quantitative",
              "scale": {
                "domain": {
                  "param": "brush"
                }
              }
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "y": 100
              }
            ]
          },
          "mark": {
            "type": "rule",
            "strokeDash": [
              4,
              4
            ],
            "color": "#8a837a",
            "strokeWidth": 1
          },
          "encoding": {
            "y": {
              "field": "y",
              "type": "quantitative"
            }
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 60,
      "params": [
        {
          "name": "brush",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ]
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Year ending June",
          "type": "quantitative",
          "axis": {
            "title": "Year ending June (drag here to zoom)",
            "format": "d",
            "tickMinStep": 1,
            "grid": false
          },
          "scale": {
            "nice": false
          }
        },
        "y": {
          "field": "Index",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "zero": false
          }
        },
        "color": {
          "field": "Industry",
          "type": "nominal",
          "legend": null
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "concat": {
      "spacing": 12
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}