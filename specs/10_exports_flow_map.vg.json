            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum['Rank'] <= 6 && datum['Country'] == 'South Korea'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "dy": -8,
            "fontSize": 12,
