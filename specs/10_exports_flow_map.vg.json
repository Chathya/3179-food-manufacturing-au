          "transform": [
            {
              "filter": "datum['Rank'] <= 6 && (indexof(['China', 'India', 'Indonesia', 'Thailand', 'Bangladesh', 'Egypt'], datum['Country']) >= 0)"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
