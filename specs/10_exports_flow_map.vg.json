{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Flow map on an Equal Earth world map centred on the Pacific, with ocean and latitude and longitude lines. Curved lines run from Australia to the fifteen biggest buyers of Australian manufactured food; line thickness shows export value. Each curve is a quadratic Bezier curve calculated inside this specification. A menu filters by food industry (Shneiderman: filter).",
  "width": "container",
  "height": 440,
  "params": [
    {
      "name": "industry",
      "value": "All food industries",
      "bind": {
        "input": "select",
        "name": "Food industry ",
        "options": [
          "All food industries",
          "Meat products",
          "Dairy products",
          "Grain and cereal products",
          "Sugar and confectionery",
          "Seafood",
          "Fruit and vegetables",
          "Bakery products",
          "Other food products"
        ]
      }
    },
    {
      "name": "labelRank",
      "value": 3
    }
  ],
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3ecf2",
        "stroke": "#c9d8e3",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/geo/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f0e8",
        "stroke": "#d9d2c6",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/clean/food_exports.csv"
      },
      "transform": [
        {
          "filter": "datum['Industry'] == industry"
        },
        {
          "calculate": "toNumber(datum['Country number'])",
          "as": "Country number"
        },
        {
          "lookup": "Country number",
          "from": {
            "data": {
              "url": "data/geo/world-110m.json",
              "format": {
                "type": "topojson",
                "feature": "countries"
              }
            },
            "key": "id"
          },
          "as": "geo"
        },
        {
          "filter": "isValid(datum['geo'])"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": {
          "expr": "industry == 'All food industries' ? '#C97F00' : industry == 'Seafood' ? '#1B3F8B' : industry == 'Bakery products' ? '#F08A00' : industry == 'Dairy products' ? '#3F9EDC' : industry == 'Grain and cereal products' ? '#D2BC55' : industry == 'Sugar and confectionery' ? '#E27AB0' : industry == 'Fruit and vegetables' ? '#7E57C2' : industry == 'Other food products' ? '#8D8579' : industry == 'Meat products' ? '#B5301F' : '#4a2c1d'"
        },
        "fillOpacity": 0.22,
        "stroke": "#d9d2c6",
        "strokeWidth": 0.4
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "Exports (million dollars)",
            "type": "quantitative",
            "title": "Food exports (million dollars)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Longitude": -28,
            "Latitude": 60,
            "Label": "60\u00b0 North"
          },
          {
            "Longitude": -28,
            "Latitude": 30,
            "Label": "30\u00b0 North"
          },
          {
            "Longitude": -28,
            "Latitude": 0,
            "Label": "Equator"
          },
          {
            "Longitude": -28,
            "Latitude": -30,
            "Label": "30\u00b0 South"
          },
          {
            "Longitude": -28,
            "Latitude": -60,
            "Label": "60\u00b0 South"
          },
          {
            "Longitude": 60,
            "Latitude": -72,
            "Label": "60\u00b0 East"
          },
          {
            "Longitude": 120,
            "Latitude": -72,
            "Label": "120\u00b0 East"
          },
          {
            "Longitude": 180,
            "Latitude": -72,
            "Label": "180\u00b0"
          },
          {
            "Longitude": -120,
            "Latitude": -72,
            "Label": "120\u00b0 West"
          },
          {
            "Longitude": -60,
            "Latitude": -72,
            "Label": "60\u00b0 West"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#7f97a8",
        "align": "left",
        "dx": 2,
        "dy": -5
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Label"
        }
      }
    },
    {
      "data": {
        "url": "data/clean/food_exports.csv"
      },
      "transform": [
        {
          "filter": "datum['Industry'] == industry"
        },
        {
          "calculate": "toNumber(datum['Exports (million dollars)'])",
          "as": "Exports"
        },
        {
          "calculate": "toNumber(datum['Rank'])",
          "as": "Rank"
        },
        {
          "calculate": "toNumber(datum['Longitude'])",
          "as": "Longitude"
        },
        {
          "calculate": "toNumber(datum['Latitude'])",
          "as": "Latitude"
        },
        {
          "calculate": "133.8",
          "as": "Origin longitude"
        },
        {
          "calculate": "-25.3",
          "as": "Origin latitude"
        }
      ],
      "layer": [
        {
          "params": [
            {
              "name": "focus",
              "select": {
                "type": "point",
                "fields": [
                  "Country"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ],
          "mark": {
            "type": "line",
            "color": {
              "expr": "industry == 'All food industries' ? '#C97F00' : industry == 'Seafood' ? '#1B3F8B' : industry == 'Bakery products' ? '#F08A00' : industry == 'Dairy products' ? '#3F9EDC' : industry == 'Grain and cereal products' ? '#D2BC55' : industry == 'Sugar and confectionery' ? '#E27AB0' : industry == 'Fruit and vegetables' ? '#7E57C2' : industry == 'Other food products' ? '#8D8579' : industry == 'Meat products' ? '#B5301F' : '#4a2c1d'"
            },
            "strokeCap": "round",
            "strokeJoin": "round",
            "interpolate": "linear"
          },
          "encoding": {
            "longitude": {
              "field": "Curve longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "Curve latitude",
              "type": "quantitative"
            },
            "order": {
              "field": "t",
              "type": "quantitative"
            },
            "detail": {
              "field": "Country",
              "type": "nominal"
            },
            "strokeWidth": {
              "field": "Exports",
              "type": "quantitative",
              "title": "Food exports (million dollars)",
              "scale": {
                "range": [
                  0.8,
                  9
                ],
                "zero": true
              },
              "legend": {
                "orient": "bottom",
                "format": ",.0f",
                "symbolStrokeColor": "#8b7f75",
                "direction": "horizontal",
                "tickCount": 4,
                "values": [
                  1000,
                  4000,
                  8000
                ]
              }
            },
            "opacity": {
              "condition": {
                "param": "focus",
                "value": 0.85
              },
              "value": 0.35
            },
            "tooltip": [
              {
                "field": "Country",
                "type": "nominal",
                "title": "Destination"
              },
              {
                "field": "Industry",
                "type": "nominal",
                "title": "Food industry"
              },
              {
                "field": "Exports",
                "type": "quantitative",
                "title": "Food exports (million dollars)",
                "format": ",.0f"
              },
              {
                "field": "Rank",
                "type": "quantitative",
                "title": "Rank among buyers"
              }
            ]
          },
          "transform": [
            {
              "calculate": "sequence(0, 1.0001, 0.05)",
              "as": "t"
            },
            {
              "flatten": [
                "t"
              ]
            },
            {
              "calculate": "((datum['Longitude'] - 150 + 540) % 360) - 180",
              "as": "Destination x"
            },
            {
              "calculate": "datum['Destination x'] + 16.2",
              "as": "dx"
            },
            {
              "calculate": "datum['Latitude'] + 25.3",
              "as": "dy"
            },
            {
              "calculate": "sqrt(datum['dx'] * datum['dx'] + datum['dy'] * datum['dy'])",
              "as": "Length"
            },
            {
              "calculate": "(datum['dx'] >= 0 ? -datum['dy'] : datum['dy']) / datum['Length']",
              "as": "nx"
            },
            {
              "calculate": "abs(datum['dx']) / datum['Length']",
              "as": "ny"
            },
            {
              "calculate": "-16.2 + datum['dx'] / 2 + 0.24 * datum['Length'] * datum['nx']",
              "as": "Control x"
            },
            {
              "calculate": "-25.3 + datum['dy'] / 2 + 0.24 * datum['Length'] * datum['ny']",
              "as": "Control y"
            },
            {
              "calculate": "150 + pow(1 - datum['t'], 2) * -16.2 + 2 * (1 - datum['t']) * datum['t'] * datum['Control x'] + pow(datum['t'], 2) * datum['Destination x']",
              "as": "Curve longitude"
            },
            {
              "calculate": "pow(1 - datum['t'], 2) * -25.3 + 2 * (1 - datum['t']) * datum['t'] * datum['Control y'] + pow(datum['t'], 2) * datum['Latitude']",
              "as": "Curve latitude"
            }
          ]
        },
        {
          "mark": {
            "type": "circle",
            "color": {
              "expr": "industry == 'All food industries' ? '#C97F00' : industry == 'Seafood' ? '#1B3F8B' : industry == 'Bakery products' ? '#F08A00' : industry == 'Dairy products' ? '#3F9EDC' : industry == 'Grain and cereal products' ? '#D2BC55' : industry == 'Sugar and confectionery' ? '#E27AB0' : industry == 'Fruit and vegetables' ? '#7E57C2' : industry == 'Other food products' ? '#8D8579' : industry == 'Meat products' ? '#B5301F' : '#4a2c1d'"
            },
            "size": 40,
            "stroke": "#ffffff",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "Longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "Latitude",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "Country",
                "type": "nominal",
                "title": "Destination"
              },
              {
                "field": "Exports",
                "type": "quantitative",
                "title": "Food exports (million dollars)",
                "format": ",.0f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum['Rank'] <= labelRank && !(indexof(['China', 'India', 'Indonesia', 'Thailand', 'Bangladesh', 'Egypt', 'Hong Kong', 'United Arab Emirates'], datum['Country']) >= 0) && datum['Country'] != 'South Korea' && datum['Country'] != 'Malaysia'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 7,
            "dy": -7,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#23201c",
            "stroke": "#ffffff",
            "strokeWidth": 3,
            "strokeOpacity": 0.8
          },
          "encoding": {
