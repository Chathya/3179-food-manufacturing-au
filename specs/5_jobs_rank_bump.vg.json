{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart. Rank of each food industry by number of workers, each year. Every industry keeps its own colour from the rest of the page. Bakeries, the key finding, are drawn thickest. Hovering a line thickens it and names the industry. A note marks 2020, when meat overtook bakeries.",
  "data": {
    "url": "data/clean/food_jobs_by_industry.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['Rank'])",
      "as": "Rank"
    },
    {
      "calculate": "toNumber(datum['Year'])",
      "as": "Year"
    },
    {
      "calculate": "toNumber(datum['Workers (thousands)'])",
      "as": "Workers"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Year",
          "as": "Last year"
        }
      ]
    }
  ],
  "width": "container",
  "height": 440,
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "nice": false
      },
      "axis": {
        "format": "d",
        "tickMinStep": 1,
        "grid": false,
        "values": [
          2006,
          2010,
          2015,
          2020,
          2025
        ]
      }
    },
    "y": {
      "field": "Rank",
      "type": "quantitative",
      "title": null,
      "scale": {
        "reverse": true,
        "domain": [
          -0.2,
          8.4
        ],
        "nice": false
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "grid": false
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "!(datum['Industry'] == 'Bakery products')"
        }
      ],
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "Industry"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.8,
        "strokeCap": "round",
        "strokeJoin": "round",
        "opacity": 0.85
      },
      "encoding": {
        "detail": {
          "field": "Industry",
          "type": "nominal"
        },
        "color": {
          "field": "Industry",
          "type": "nominal",
          "scale": {
            "domain": [
              "Meat products",
              "Bakery products",
              "Dairy products",
              "Sugar and confectionery",
              "Fruit and vegetables",
              "Grain and cereal products",
              "Seafood",
              "Other food products"
            ],
            "range": [
              "#B5301F",
              "#F08A00",
              "#3F9EDC",
              "#E27AB0",
              "#7E57C2",
              "#D2BC55",
              "#1B3F8B",
              "#8D8579"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "param": "pick",
            "empty": false
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 5,
        "strokeCap": "round",
        "strokeJoin": "round"
      },
      "encoding": {
        "detail": {
          "field": "Industry",
          "type": "nominal"
        },
        "color": {
          "field": "Industry",
          "type": "nominal",
          "scale": {
            "domain": [
              "Meat products",
              "Bakery products",
              "Dairy products",
              "Sugar and confectionery",
              "Fruit and vegetables",
              "Grain and cereal products",
              "Seafood",
              "Other food products"
            ],
            "range": [
              "#B5301F",
              "#F08A00",
              "#3F9EDC",
              "#E27AB0",
              "#7E57C2",
              "#D2BC55",
              "#1B3F8B",
              "#8D8579"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!(datum['Industry'] == 'Bakery products')"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 50,
        "opacity": 0.9
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Industry",
            "type": "nominal",
            "title": "Food industry"
          },
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "Rank",
            "type": "quantitative",
            "title": "Rank"
          },
          {
            "field": "Workers",
            "type": "quantitative",
            "title": "Workers (thousands)",
            "format": ".1f"
          }
        ],
        "color": {
          "field": "Industry",
          "type": "nominal",
          "scale": {
            "domain": [
              "Meat products",
              "Bakery products",
              "Dairy products",
              "Sugar and confectionery",
              "Fruit and vegetables",
              "Grain and cereal products",
              "Seafood",
              "Other food products"
            ],
            "range": [
              "#B5301F",
              "#F08A00",
              "#3F9EDC",
              "#E27AB0",
              "#7E57C2",
              "#D2BC55",
              "#1B3F8B",
              "#8D8579"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum['Industry'] == 'Bakery products'"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 6,
        "color": "#F08A00",
        "strokeCap": "round",
        "strokeJoin": "round"
      }
    },
    {
      "transform": [
        {
          "filter": "datum['Industry'] == 'Bakery products'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "color": "#F08A00"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Industry",
            "type": "nominal",
            "title": "Food industry"
          },
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "Rank",
            "type": "quantitative",
            "title": "Rank"
          },
          {
            "field": "Workers",
            "type": "quantitative",
            "title": "Workers (thousands)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum['Year'] == datum['Last year'] && !(datum['Industry'] == 'Bakery products')"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 13,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "Industry"
        },
        "color": {
          "field": "Industry",
          "type": "nominal",
          "scale": {
            "domain": [
              "Meat products",
              "Bakery products",
              "Dairy products",
              "Sugar and confectionery",
              "Fruit and vegetables",
              "Grain and cereal products",
              "Seafood",
              "Other food products"
            ],
            "range": [
              "#b5301f",
              "#9a5200",
              "#1a639a",
              "#a22f6f",
              "#6c45b0",
              "#6b5c0c",
              "#1b3f8b",
              "#5f564d"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum['Year'] == datum['Last year'] && datum['Industry'] == 'Bakery products'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#9a5200"
      },
      "encoding": {
        "text": {
          "field": "Industry"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": 2020,
            "Rank": 0.2,
            "Text": "2020: Covid-19 year. Bakeries lost 9 thousand workers while meat gained 3 thousand."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12.5,
        "fontStyle": "italic",
        "color": "#3d3731"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative"
        },
        "y": {
          "field": "Rank",
          "type": "quantitative"
        },
        "text": {
          "field": "Text"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 175
  }
}