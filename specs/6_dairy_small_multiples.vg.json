{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples. Annual production of the four main dairy products, drawn as straight line segments so every spike shows. All four panels share one vertical scale, so heights can be compared directly. A dashed line marks 2003, a drought year in which all four products fell. The latest year is marked with a hollow dot.",
  "data": {
    "url": "data/clean/dairy_products.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['Production (thousand tonnes)'])",
      "as": "Production"
    },
    {
      "calculate": "toNumber(datum['Year ending June'])",
      "as": "Year ending June"
    }
  ],
  "facet": {
    "field": "Product",
    "type": "nominal",
    "title": null,
    "sort": [
      "Cheese",
      "Butter",
      "Skim milk powder",
      "Whole milk powder"
    ],
    "header": {
      "labelAnchor": "start",
      "labelPadding": 3,
      "labelFontSize": 14
    }
  },
  "columns": 2,
  "spec": {
    "width": 290,
    "height": 120,
    "layer": [
      {
        "transform": [
          {
            "filter": "datum['Year ending June'] == 2003"
          }
        ],
        "mark": {
          "type": "rule",
          "strokeDash": [
            4,
            3
          ],
          "strokeWidth": 1.5,
          "color": "#7a7266"
        },
        "encoding": {
          "x": {
            "field": "Year ending June",
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": false
            }
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#3F9EDC",
          "strokeWidth": 2.5,
          "interpolate": "linear",
          "strokeJoin": "round"
        },
        "encoding": {
          "x": {
            "field": "Year ending June",
            "type": "quantitative",
            "title": null,
            "axis": {
              "format": "d",
              "tickCount": 4,
              "grid": false
            }
          },
          "y": {
            "field": "Production",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                0,
                480
              ],
              "nice": false
            },
            "axis": {
              "values": [
                0,
                200,
                400
              ],
              "tickCount": 3
            }
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "opacity": 0,
          "size": 150
        },
        "encoding": {
          "x": {
            "field": "Year ending June",
            "type": "quantitative"
          },
          "y": {
            "field": "Production",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "Product",
              "type": "nominal",
              "title": "Product"
            },
            {
              "field": "Year",
              "type": "nominal",
              "title": "Financial year"
            },
            {
              "field": "Production",
              "type": "quantitative",
              "title": "Production (thousand tonnes)",
              "format": ",.0f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "joinaggregate": [
              {
                "op": "max",
                "field": "Year ending June",
                "as": "Last"
              }
            ],
            "groupby": [
              "Product"
            ]
          },
          {
            "filter": "datum['Year ending June'] == datum['Last']"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 70,
          "color": "#FFFFFF",
          "stroke": "#3F9EDC",
          "strokeWidth": 2.5
        },
        "encoding": {
          "x": {
            "field": "Year ending June",
            "type": "quantitative"
          },
          "y": {
            "field": "Production",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "Product",
              "type": "nominal",
              "title": "Product"
            },
            {
              "field": "Year",
              "type": "nominal",
              "title": "Financial year"
            },
            {
              "field": "Production",
              "type": "quantitative",
              "title": "Production (thousand tonnes)",
              "format": ",.0f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum['Year ending June'] == 2003 && datum['Product'] == 'Cheese'"
          },
          {
            "calculate": "'2003 drought: all four fell'",
            "as": "Note"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "top",
          "dx": -6,
          "fontSize": 11.5,
          "fontStyle": "italic",
          "color": "#3d3731"
        },
        "encoding": {
          "x": {
            "field": "Year ending June",
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": false
            }
          },
          "y": {
            "value": 2
          },
          "text": {
            "field": "Note"
          }
        }
      }
    ]
  },
  "resolve": {
    "axis": {
      "x": "independent"
    }
  }
}