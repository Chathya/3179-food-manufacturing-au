{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart in two panels. Grams of each food group bought per person per day in 2018 to 2019 (hollow dot) and 2023 to 2024 (filled dot). Bars are blue where buying rose and orange where it fell. Everyday staples and smaller items get their own scale so small changes stay visible. Sorted by percentage change.",
  "data": {
    "url": "data/clean/food_consumption.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['Grams per person per day'])",
      "as": "Grams"
    },
    {
      "pivot": "Year",
      "value": "Grams",
      "groupby": [
        "Food group",
        "Food group (full name)",
        "Panel"
      ]
    },
    {
      "calculate": "datum['2023 to 2024'] - datum['2018 to 2019']",
      "as": "Change in grams"
    },
    {
      "calculate": "datum['Change in grams'] >= 0 ? 'Bought more' : 'Bought less'",
      "as": "Direction"
    },
    {
      "calculate": "round(datum['Change in grams'] / datum['2018 to 2019'] * 1000) / 10",
      "as": "Change in per cent"
    },
    {
      "calculate": "max(datum['2018 to 2019'], datum['2023 to 2024'])",
      "as": "Right end"
    },
    {
      "calculate": "(datum['Change in per cent'] > 0 ? '+' : '') + format(datum['Change in per cent'], '.0f') + '%'",
      "as": "Change label"
    }
  ],
  "facet": {
    "row": {
      "field": "Panel",
      "type": "nominal",
      "title": null,
      "sort": [
        "Everyday staples (over 100 grams a day)",
        "Smaller items (under 100 grams a day)"
      ],
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelAnchor": "start",
        "labelOrient": "top",
        "labelPadding": 6
      }
    }
  },
  "spec": {
    "width": 430,
    "height": {
      "step": 26
    },
    "encoding": {
      "y": {
        "field": "Food group",
        "type": "nominal",
        "title": null,
        "sort": {
          "field": "Change in per cent",
          "order": "descending"
        },
        "axis": {
          "ticks": false,
          "domain": false,
          "labelLimit": 240,
          "grid": true,
          "gridColor": "#f3efe8"
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "rule",
          "strokeWidth": 5,
          "strokeCap": "round"
        },
        "encoding": {
          "x": {
            "field": "2018 to 2019",
            "type": "quantitative",
            "title": "Grams per person per day",
            "scale": {
              "zero": false
            },
            "axis": {
              "tickCount": 5,
              "format": ",.0f"
            }
          },
          "x2": {
            "field": "2023 to 2024"
          },
          "color": {
            "field": "Direction",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "Bought more",
                "Bought less"
              ],
              "range": [
                "#1f7a74",
                "#a0522d"
              ]
            },
            "legend": {
              "orient": "top",
              "direction": "horizontal"
            }
          },
          "tooltip": [
            {
              "field": "Food group (full name)",
              "type": "nominal",
              "title": "Food group"
            },
            {
              "field": "2018 to 2019",
              "type": "quantitative",
              "title": "Grams a day in 2018 to 2019",
              "format": ".1f"
            },
            {
              "field": "2023 to 2024",
              "type": "quantitative",
              "title": "Grams a day in 2023 to 2024",
              "format": ".1f"
            },
            {
              "field": "Change in per cent",
              "type": "quantitative",
              "title": "Change (per cent)",
              "format": "+.1f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "fill": "#ffffff",
          "stroke": "#57514a",
          "size": 70,
          "strokeWidth": 2
        },
        "encoding": {
          "x": {
            "field": "2018 to 2019",
            "type": "quantitative"
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 70,
          "color": "#23201c"
        },
        "encoding": {
          "x": {
            "field": "2023 to 2024",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "Food group (full name)",
              "type": "nominal",
              "title": "Food group"
            },
            {
              "field": "2023 to 2024",
              "type": "quantitative",
              "title": "Grams a day in 2023 to 2024",
              "format": ".1f"
            },
            {
              "field": "Change in per cent",
              "type": "quantitative",
              "title": "Change since 2018 to 2019 (per cent)",
              "format": "+.1f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 10,
          "fontSize": 11,
          "color": "#57514a"
        },
        "encoding": {
          "x": {
            "field": "Right end",
            "type": "quantitative"
          },
          "text": {
            "field": "Change label"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  },
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 62
  }
}