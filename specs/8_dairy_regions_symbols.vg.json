{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map. Each circle is one of Australia's eight dairy regions, sized by the milk it produced in 2024 to 2025. Circle area, not radius, is proportional to milk volume.",
  "width": "container",
  "height": 410,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/geo/au_states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece7de",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/clean/dairy_regions.csv"
      },
      "transform": [
        {
          "calculate": "toNumber(datum['Milk produced (million litres)'])",
          "as": "Milk"
        },
        {
          "calculate": "toNumber(datum['Longitude'])",
          "as": "Longitude"
        },
        {
          "calculate": "toNumber(datum['Latitude'])",
          "as": "Latitude"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "color": "#3F9EDC",
            "opacity": 0.7,
            "stroke": "#ffffff",
            "strokeWidth": 2
          },
          "encoding": {
            "size": {
              "field": "Milk",
              "type": "quantitative",
              "title": "Milk produced (million litres)",
              "scale": {
                "type": "sqrt",
                "range": [
                  0,
                  1700
                ],
                "zero": true
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "symbolFillColor": "#3F9EDC",
                "symbolStrokeColor": "#ffffff",
                "format": ",.0f",
                "values": [
                  400,
                  1000,
                  1900
                ],
                "offset": 14,
                "titleOrient": "left"
              }
            },
            "tooltip": [
              {
                "field": "Region (full name)",
                "type": "nominal",
                "title": "Dairy region"
              },
              {
                "field": "Milk",
                "type": "quantitative",
                "title": "Milk produced, July 2024 to June 2025 (million litres)",
                "format": ",.0f"
              },
              {
                "field": "Share of national milk (per cent)",
                "type": "quantitative",
                "title": "Share of all Australian milk (per cent)",
                "format": ".0f"
              },
              {
                "field": "Dairy farms",
                "type": "quantitative",
                "title": "Dairy farms in 2025",
                "format": ","
              },
              {
                "field": "Dairy farms 2021",
                "type": "quantitative",
                "title": "Dairy farms in 2021",
                "format": ","
              },
              {
                "field": "Change in milk since 2021 (per cent)",
                "type": "quantitative",
                "title": "Change in milk since 2021 (per cent)",
                "format": "+.0f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#23201c"
          },
          "encoding": {
            "longitude": {
              "field": "Label longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "Label latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "Region"
            }
          },
          "transform": [
            {
              "filter": "datum['Label side'] == 'right'"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#23201c"
          },
          "encoding": {
            "longitude": {
              "field": "Label longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "Label latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "Region"
            }
          },
          "transform": [
            {
              "filter": "datum['Label side'] == 'left'"
            }
          ]
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "Longitude": 163.6,
            "Latitude": -38.3,
            "Text": "Victoria's three regions|make 67% of all milk"
          }
        ]
      },
      "mark": {
        "type": "text",
        "lineBreak": "|",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#1A639A",
        "align": "center",
        "baseline": "bottom"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Longitude": 156.0,
            "Latitude": -37.9,
            "Order": 0
          },
          {
            "Longitude": 150.2,
            "Latitude": -37.9,
            "Order": 1
          }
        ]
      },
      "mark": {
        "type": "line",
        "color": "#1A639A",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "Order",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Longitude": 149.9,
            "Latitude": -37.9
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "size": 90,
        "color": "#1A639A",
        "angle": 270
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        }
      }
    }
  ],
  "view": {
    "stroke": null
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 78
  }
}