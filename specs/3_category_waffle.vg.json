{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart. One hundred squares, each one per cent of food manufacturing value added in 2024-25, coloured by food industry.",
  "data": {
    "url": "data/clean/food_waffle.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['Square'])",
      "as": "Square"
    },
    {
      "calculate": "datum['Square'] % 20",
      "as": "Column"
    },
    {
      "calculate": "floor(datum['Square'] / 20)",
      "as": "Row"
    }
  ],
  "width": "container",
  "height": 170,
  "mark": {
    "type": "square",
    "size": 330,
    "filled": true,
    "stroke": "#ffffff",
    "strokeWidth": 2,
    "opacity": 1
  },
  "encoding": {
    "x": {
      "field": "Column",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "Row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "Industry",
      "type": "nominal",
      "scale": {
        "domain": [
          "Meat products",
          "Bakery products",
          "Dairy products",
          "Sugar and confectionery",
          "Fruit and vegetables",
          "Grain and cereal products",
          "Seafood",
          "Other food products"
        ],
        "range": [
          "#e34948",
          "#eb6834",
          "#1baf7a",
          "#e87ba4",
          "#008300",
          "#eda100",
          "#2a78d6",
          "#6250d6"
        ]
      },
      "legend": {
        "orient": "bottom",
        "title": null,
        "columns": 4,
        "symbolType": "square",
        "labelLimit": 220,
        "columnPadding": 24,
        "rowPadding": 6
      }
    },
    "tooltip": [
      {
        "field": "Industry",
        "type": "nominal",
        "title": "Food industry"
      },
      {
        "field": "Share (per cent)",
        "type": "quantitative",
        "title": "Share of food value added (per cent)",
        "format": ".1f"
      },
      {
        "field": "Value added (million dollars)",
        "type": "quantitative",
        "title": "Value added (million dollars)",
        "format": ",.0f"
      }
    ],
    "opacity": {
      "condition": {
        "param": "pick",
        "value": 1
      },
      "value": 0.2
    }
  },
  "params": [
    {
      "name": "pick",
      "select": {
        "type": "point",
        "fields": [
          "Industry"
        ]
      },
      "bind": "legend"
    }
  ]
}