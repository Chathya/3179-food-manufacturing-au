{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart. Each square is one per cent of food manufacturing value added in 2024 to 2025. Squares fill down each column, so every food industry forms one block. Colour hue shows the food industry. Seafood is under one per cent, so it is drawn as an outline instead of a full square.",
  "data": {
    "url": "data/clean/food_waffle.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum['Square'])",
      "as": "Square"
    },
    {
      "calculate": "datum['Industry'] == 'Seafood' ? 99 : datum['Industry'] == 'Other food products' ? datum['Square'] - 1 : datum['Square']",
      "as": "Position"
    },
    {
      "calculate": "floor(datum['Position'] / 5) + 0.07",
      "as": "Left"
    },
    {
      "calculate": "floor(datum['Position'] / 5) + 0.93",
      "as": "Right"
    },
    {
      "calculate": "datum['Position'] % 5 + 0.07",
      "as": "Top"
    },
    {
      "calculate": "datum['Position'] % 5 + 0.93",
      "as": "Bottom"
    }
  ],
  "width": "container",
  "height": 190,
  "padding": {
    "left": 4,
    "right": 4,
    "top": 6,
    "bottom": 4
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum['Industry'] != 'Seafood'"
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 2
      },
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "Industry"
            ]
          },
          "bind": "legend"
        }
      ],
      "encoding": {
        "x": {
          "field": "Left",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              20
            ],
            "nice": false
          }
        },
        "x2": {
          "field": "Right"
        },
        "y": {
          "field": "Top",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              5
            ],
            "reverse": true,
            "nice": false
          }
        },
        "y2": {
          "field": "Bottom"
        },
        "color": {
          "field": "Industry",
          "type": "nominal",
          "scale": {
            "domain": [
              "Meat products",
              "Bakery products",
              "Dairy products",
              "Sugar and confectionery",
              "Fruit and vegetables",
              "Grain and cereal products",
              "Seafood",
              "Other food products"
            ],
            "range": [
              "#B5301F",
              "#F08A00",
              "#3F9EDC",
              "#E27AB0",
              "#7E57C2",
              "#D2BC55",
              "#1B3F8B",
              "#8D8579"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "columns": 4,
            "symbolType": "square",
            "labelLimit": 260,
            "columnPadding": 10,
            "rowPadding": 5,
            "labelFontSize": 12,
            "labelExpr": "datum.label == 'Meat products' ? 'Meat products  35%' : datum.label == 'Bakery products' ? 'Bakery products  15%' : datum.label == 'Dairy products' ? 'Dairy products  11%' : datum.label == 'Sugar and confectionery' ? 'Sugar and confectionery  10%' : datum.label == 'Fruit and vegetables' ? 'Fruit and vegetables  6%' : datum.label == 'Grain and cereal products' ? 'Grain and cereal products  5%' : datum.label == 'Seafood' ? 'Seafood  under 1% (outline)' : datum.label == 'Other food products' ? 'Other food products  17%' : datum.label"
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "Industry",
            "type": "nominal",
            "title": "Food industry"
          },
          {
            "field": "Share (per cent)",
            "type": "quantitative",
            "title": "Share of food value added (per cent)",
            "format": ".1f"
          },
          {
            "field": "Value added (million dollars)",
            "type": "quantitative",
            "title": "Value added (million dollars)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum['Industry'] == 'Seafood'"
        }
      ],
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "fill": null,
        "stroke": "#1B3F8B",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "Left",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              20
            ],
            "nice": false
          }
        },
        "x2": {
          "field": "Right"
        },
        "y": {
          "field": "Top",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              5
            ],
            "reverse": true,
            "nice": false
          }
        },
        "y2": {
          "field": "Bottom"
        },
        "tooltip": [
          {
            "field": "Industry",
            "type": "nominal",
            "title": "Food industry"
          },
          {
            "field": "Share (per cent)",
            "type": "quantitative",
            "title": "Share of food value added (per cent)",
            "format": ".1f"
          },
          {
            "field": "Value added (million dollars)",
            "type": "quantitative",
            "title": "Value added (million dollars)",
            "format": ",.0f"
          }
        ]
      }
    }
  ]
}